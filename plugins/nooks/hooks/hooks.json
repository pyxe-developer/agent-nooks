{
  "description": "Agent Nooks wakes the Claude Code session used last in this repo.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/nooks\" hook prompt claude-code"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/nooks\" hook listen claude-code",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/nooks\" hook listen claude-code",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
